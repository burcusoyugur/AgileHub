@using AgileHub.Services
@model List<Sprint>
@{
    ViewData["Title"] = "Sprintler";
    var projeId = (int)ViewBag.ProjeId;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">@ViewData["Title"]</h1>
        <div class="text-muted small">@ViewBag.ProjeAdi</div>
    </div>
    <a class="btn btn-primary" asp-action="Create" asp-route-projeId="@projeId">Yeni sprint</a>
</div>

@if (TempData["Mesaj"] is string mesaj)
{
    <div class="alert alert-success">@mesaj</div>
}

@if (TempData["Hata"] is string hata)
{
    <div class="alert alert-danger">@hata</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        Bu projede henüz sprint yok. <a asp-action="Create" asp-route-projeId="@projeId">İlk sprinti oluşturun.</a>
    </div>
}
else
{
    <div class="list-group mb-3">
        @foreach (var sprint in Model)
        {
            // Story point toplamları API ile aynı hesaptan gelsin diye DTO kullanılır.
            var dto = sprint.ToDto();
            var yuzde = dto.ToplamStoryPoint > 0 ? dto.TamamlananStoryPoint * 100 / dto.ToplamStoryPoint : 0;

            <a class="list-group-item list-group-item-action" asp-action="Details" asp-route-id="@sprint.Id">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span class="fw-semibold">@sprint.Ad</span>
                    <partial name="_SprintDurumRozeti" model="sprint.Durum" />
                </div>
                <div class="text-muted small mb-2">
                    @sprint.BaslangicTarihi.ToString("dd.MM.yyyy") – @sprint.BitisTarihi.ToString("dd.MM.yyyy")
                    · @sprint.Gorevler.Count görev
                </div>
                <div class="progress" role="progressbar" aria-label="Tamamlanan story point"
                     aria-valuenow="@yuzde" aria-valuemin="0" aria-valuemax="100" style="height: 6px">
                    <div class="progress-bar bg-success" style="width: @yuzde%"></div>
                </div>
                <div class="text-muted small mt-1">@dto.TamamlananStoryPoint / @dto.ToplamStoryPoint story point</div>
            </a>
        }
    </div>
}

<a asp-controller="Proje" asp-action="Details" asp-route-id="@projeId">&larr; Projeye dön</a>
