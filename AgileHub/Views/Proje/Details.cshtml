@model Proje
@{
    ViewData["Title"] = Model.Ad;
    var olusturanBenMiyim = ViewBag.OlusturanBenMiyim as bool? ?? false;
}

@if (TempData["Mesaj"] is string mesaj)
{
    <div class="alert alert-success">@mesaj</div>
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-1">@Model.Ad</h1>
        <div class="text-muted small">
            Oluşturan: @Model.OlusturanKullanici?.Ad @Model.OlusturanKullanici?.Soyad
            · @Model.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")
        </div>
    </div>
    @if (olusturanBenMiyim)
    {
        <div>
            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Düzenle</a>
            <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Sil</a>
        </div>
    }
</div>

<section class="mb-4">
    <h2 class="h5">Açıklama</h2>
    @if (string.IsNullOrWhiteSpace(Model.Aciklama))
    {
        <p class="text-muted">Açıklama eklenmemiş.</p>
    }
    else
    {
        <p style="white-space: pre-line">@Model.Aciklama</p>
    }
</section>

<div class="row mb-4">
    <div class="col-sm-4">
        <div class="card text-center">
            <div class="card-body">
                <div class="h4 mb-0">@Model.Sprintler.Count</div>
                <div class="text-muted small">Sprint</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card text-center">
            <div class="card-body">
                <div class="h4 mb-0">@Model.Gorevler.Count</div>
                <div class="text-muted small">Görev</div>
            </div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="card text-center">
            <div class="card-body">
                <div class="h4 mb-0">@Model.ProjeUyeleri.Count</div>
                <div class="text-muted small">Üye</div>
            </div>
        </div>
    </div>
</div>

<section id="uyeler" class="mb-4">
    <h2 class="h5">Üyeler</h2>
    @* Üye ekleme/çıkarma bölümü ProjeUyeleriController ile bu alana bağlanacak. *@
    <ul class="list-group">
        @foreach (var uye in Model.ProjeUyeleri.OrderBy(u => u.KatilmaTarihi))
        {
            <li class="list-group-item d-flex justify-content-between">
                <span>@uye.Kullanici?.Ad @uye.Kullanici?.Soyad <span class="text-muted small">@uye.Kullanici?.Email</span></span>
                @if (uye.KullaniciId == Model.OlusturanKullaniciId)
                {
                    <span class="badge bg-secondary">Oluşturan</span>
                }
            </li>
        }
    </ul>
</section>

<a asp-action="Index">&larr; Projelerime dön</a>
