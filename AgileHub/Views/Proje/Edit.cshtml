@model ProjeFormViewModel
@{
    ViewData["Title"] = "Projeyi düzenle";
}

<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <partial name="_ProjeForm" model="Model" />
            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a class="btn btn-link" asp-action="Details" asp-route-id="@Model.Id">Vazgeç</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
