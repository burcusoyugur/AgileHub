@model HomeIndexViewModel
@{
    ViewData["Title"] = "Ana Sayfa";

    // Bu sayfadaki bütün hesaplamalar yalnızca görünüm içindir; veriler controller'dan geldiği gibi kullanılır.
    var ad = string.IsNullOrWhiteSpace(Model.AdSoyad) ? "" : Model.AdSoyad.Split(' ')[0];

    var toplamSp = Model.AktifSprintler.Sum(s => s.ToplamStoryPoint);
    var tamamlananSp = Model.AktifSprintler.Sum(s => s.TamamlananStoryPoint);
    var genelIlerleme = toplamSp == 0 ? 0 : tamamlananSp * 100 / toplamSp;

    var bitisSirasi = Model.AktifSprintler.OrderBy(s => s.BitisTarihi).ToList();

    string OncelikSinifi(GorevOnceligi oncelik) => oncelik switch
    {
        GorevOnceligi.Kritik => "rozet-kirmizi",
        GorevOnceligi.Yuksek => "rozet-turuncu",
        GorevOnceligi.Orta => "rozet-mavi",
        _ => "rozet-gri"
    };

    string OncelikMetni(GorevOnceligi oncelik) => oncelik switch
    {
        GorevOnceligi.Kritik => "Kritik",
        GorevOnceligi.Yuksek => "Yüksek",
        GorevOnceligi.Orta => "Orta",
        _ => "Düşük"
    };

    string DurumMetni(GorevDurumu durum) => durum switch
    {
        GorevDurumu.Yapiliyor => "Yapılıyor",
        GorevDurumu.Test => "Test",
        GorevDurumu.Bitti => "Bitti",
        _ => "Yapılacak"
    };

    string KalanGunMetni(int gun) => gun == 0 ? "Bugün bitiyor" : $"{gun} gün kaldı";

    string BasHarf(string metin) => string.IsNullOrWhiteSpace(metin) ? "?" : metin.Trim()[..1].ToUpper();
}

<link rel="stylesheet" href="~/css/anasayfa.css" asp-append-version="true" />

<div class="pano">
    <div class="pano-ic pano-izgara">
        @* ---------- Sol ve orta: karşılama, özet, kısayollar, sprintler, görevler ---------- *@
        <div class="pano-ana">

            <section class="karsilama">
                <div>
                    <h1>Merhaba@(ad == "" ? "" : " " + ad) <span aria-hidden="true">👋</span></h1>
                    <p>AgileHub'a hoş geldin! Ekiplerinle birlikte projelerini planla, takip et ve hedeflerine ulaş.</p>
                </div>
                <p class="karsilama-soz">"Küçük adımlar,<br />büyük ürünler."</p>
            </section>

            @* Özet kartları *@
            <section class="ozet-izgara" aria-label="Özet">
                <a class="ozet-kart" href="/Proje">
                    <span class="ozet-simge simge-mavi" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /></svg>
                    </span>
                    <span class="ozet-metin">
                        <span class="ozet-baslik">Toplam proje</span>
                        <span class="ozet-sayi">@Model.ProjeSayisi</span>
                        <span class="ozet-alt">Üyesi olduğun</span>
                    </span>
                </a>
                <a class="ozet-kart" href="#aktif-sprintler">
                    <span class="ozet-simge simge-yesil" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M13 2 4 14h7l-1 8 9-12h-7z" /></svg>
                    </span>
                    <span class="ozet-metin">
                        <span class="ozet-baslik">Aktif sprint</span>
                        <span class="ozet-sayi">@Model.AktifSprintSayisi</span>
                        <span class="ozet-alt">Devam eden</span>
                    </span>
                </a>
                <a class="ozet-kart" href="#gorevlerim">
                    <span class="ozet-simge simge-mor" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M9 11l3 3 8-8M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9" /></svg>
                    </span>
                    <span class="ozet-metin">
                        <span class="ozet-baslik">Açık görevim</span>
                        <span class="ozet-sayi">@Model.AcikGorevSayisi</span>
                        <span class="ozet-alt">Bana atanan</span>
                    </span>
                </a>
                <a class="ozet-kart" href="#aktif-sprintler">
                    <span class="ozet-simge simge-turuncu" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2" /></svg>
                    </span>
                    <span class="ozet-metin">
                        <span class="ozet-baslik">Sprint ilerlemesi</span>
                        <span class="ozet-sayi">%@genelIlerleme</span>
                        <span class="ozet-alt">@tamamlananSp / @toplamSp story point</span>
                    </span>
                </a>
            </section>

            @* Kısayollar *@
            <section class="kisayol-izgara" aria-label="Kısayollar">
                <a class="kisayol" href="/Proje">
                    <span class="ozet-simge simge-mavi" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M16 11a4 4 0 1 0-8 0M3 21a9 9 0 0 1 18 0" /></svg>
                    </span>
                    <span>
                        <strong>Projeler ve ekip</strong>
                        <small>Proje oluştur, ekip arkadaşlarını e-posta ile projeye ekle.</small>
                    </span>
                    <span class="kisayol-ok" aria-hidden="true">›</span>
                </a>
                <a class="kisayol" href="/Proje">
                    <span class="ozet-simge simge-mavi" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h10" /></svg>
                    </span>
                    <span>
                        <strong>Backlog ve sprintler</strong>
                        <small>Görevleri önceliğe ve story point'e göre planla, sprintlere ata.</small>
                    </span>
                    <span class="kisayol-ok" aria-hidden="true">›</span>
                </a>
                <a class="kisayol" href="#aktif-sprintler">
                    <span class="ozet-simge simge-mor" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 9 9h-9z" /></svg>
                    </span>
                    <span>
                        <strong>İlerleme takibi</strong>
                        <small>Aktif sprintleri, kalan günleri ve sana atanan görevleri tek bakışta gör.</small>
                    </span>
                    <span class="kisayol-ok" aria-hidden="true">›</span>
                </a>
            </section>

            @* Aktif sprintler *@
            <section id="aktif-sprintler">
                <div class="bolum-baslik">
                    <h2>Aktif sprintler</h2>
                </div>
                @if (!Model.AktifSprintler.Any())
                {
                    <p class="bos-metin bos-kutu">Üyesi olduğun projelerde şu an aktif sprint yok.</p>
                }
                else
                {
                    <div class="sprint-izgara">
                        @foreach (var sprint in Model.AktifSprintler)
                        {
                            <a class="sprint-kart" href="/Sprint/Details/@sprint.Id">
                                <span class="sprint-ust">
                                    <strong>@sprint.Ad</strong>
                                    <span class="rozet @(sprint.KalanGun <= 2 ? "rozet-kirmizi" : "rozet-yesil")">@KalanGunMetni(sprint.KalanGun)</span>
                                </span>
                                <span class="sprint-alt">@sprint.ProjeAdi · bitiş @sprint.BitisTarihi.ToString("dd.MM.yyyy")</span>
                                <span class="ilerleme-satir">
                                    <span class="ilerleme" role="progressbar" aria-label="Story point ilerlemesi"
                                          aria-valuenow="@sprint.IlerlemeYuzdesi" aria-valuemin="0" aria-valuemax="100">
                                        <span class="ilerleme-dolu" style="width: @sprint.IlerlemeYuzdesi%"></span>
                                    </span>
                                    <span class="ilerleme-yuzde">%@sprint.IlerlemeYuzdesi</span>
                                </span>
                                <span class="sprint-alt">@sprint.TamamlananStoryPoint / @sprint.ToplamStoryPoint story point tamamlandı</span>
                            </a>
                        }
                    </div>
                }
            </section>

            @* Bana atanan görevler *@
            <section id="gorevlerim">
                <div class="bolum-baslik">
                    <h2>Bana atanan görevler</h2>
                </div>
                @if (!Model.BanaAtananGorevler.Any())
                {
                    <p class="bos-metin bos-kutu">Sana atanmış açık görev yok.</p>
                }
                else
                {
                    <div class="gorev-liste">
                        @foreach (var gorev in Model.BanaAtananGorevler)
                        {
                            <a class="gorev-satir" href="/Gorev/Details/@gorev.Id">
                                <span class="gorev-bilgi">
                                    <strong>@gorev.Baslik</strong>
                                    <small>
                                        @gorev.Proje?.Ad · @DurumMetni(gorev.Durum)
                                        @if (gorev.StoryPoint is int sp)
                                        {
                                            <span>· @sp SP</span>
                                        }
                                    </small>
                                </span>
                                <span class="rozet @OncelikSinifi(gorev.Oncelik)">@OncelikMetni(gorev.Oncelik)</span>
                            </a>
                        }
                    </div>
                    @if (Model.AcikGorevSayisi > Model.BanaAtananGorevler.Count)
                    {
                        <p class="bos-metin mt-2">
                            En öncelikli @Model.BanaAtananGorevler.Count görev gösteriliyor (toplam @Model.AcikGorevSayisi).
                        </p>
                    }
                }
            </section>
        </div>

        @* ---------- Sağ sütun: yaklaşan bitişler ve son projeler ---------- *@
        <aside class="pano-yan">
            <section class="yan-kart">
                <div class="bolum-baslik">
                    <h2>Yaklaşan sprint bitişleri</h2>
                </div>
                @if (!bitisSirasi.Any())
                {
                    <p class="bos-metin">Aktif sprint yok.</p>
                }
                else
                {
                    <ol class="zaman-cizelgesi">
                        @foreach (var sprint in bitisSirasi)
                        {
                            <li>
                                <span class="zaman-nokta @(sprint.KalanGun <= 2 ? "nokta-kirmizi" : "nokta-yesil")" aria-hidden="true"></span>
                                <a href="/Sprint/Details/@sprint.Id">
                                    <strong>@sprint.Ad</strong>
                                    <small>@sprint.ProjeAdi · @sprint.BitisTarihi.ToString("dd.MM.yyyy")</small>
                                </a>
                                <span class="rozet @(sprint.KalanGun <= 2 ? "rozet-kirmizi" : "rozet-yesil")">@KalanGunMetni(sprint.KalanGun)</span>
                            </li>
                        }
                    </ol>
                }
            </section>

            <section class="yan-kart">
                <div class="bolum-baslik">
                    <h2>Son projeler</h2>
                    <a href="/Proje">Tümünü gör</a>
                </div>
                @if (!Model.SonProjeler.Any())
                {
                    <p class="bos-metin">
                        Henüz bir projen yok. <a href="/Proje/Create">İlk projeni oluştur.</a>
                    </p>
                }
                else
                {
                    <ul class="proje-liste">
                        @foreach (var proje in Model.SonProjeler)
                        {
                            <li>
                                <a href="/Proje/Details/@proje.Id">
                                    <span class="bas-harf" aria-hidden="true">@BasHarf(proje.Ad)</span>
                                    <span>
                                        <strong>@proje.Ad</strong>
                                        <small>@proje.OlusturmaTarihi.ToString("dd.MM.yyyy")</small>
                                    </span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </section>
        </aside>
    </div>
</div>
