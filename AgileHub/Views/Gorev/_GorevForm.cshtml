@using Microsoft.AspNetCore.Mvc.Rendering
@model GorevFormViewModel
@{
    var oncelikler = Enum.GetValues<GorevOnceligi>()
        .OrderByDescending(o => o)
        .Select(o => new SelectListItem(o.Metin(), o.ToString()));
    var durumlar = Enum.GetValues<GorevDurumu>()
        .Select(d => new SelectListItem(d.Metin(), d.ToString()));
    var duzenlemeMi = Model.Id != 0;
}

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<input type="hidden" asp-for="ProjeId" />

<div class="mb-3">
    <label asp-for="Baslik" class="form-label"></label>
    <input asp-for="Baslik" class="form-control" placeholder="Örn. Giriş sayfasına şifremi unuttum bağlantısı ekle" />
    <span asp-validation-for="Baslik" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Aciklama" class="form-label"></label>
    <textarea asp-for="Aciklama" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Aciklama" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-sm-6 mb-3">
        <label asp-for="Oncelik" class="form-label"></label>
        <select asp-for="Oncelik" asp-items="oncelikler" class="form-select"></select>
        <span asp-validation-for="Oncelik" class="text-danger"></span>
    </div>
    @if (duzenlemeMi)
    {
        <div class="col-sm-6 mb-3">
            <label asp-for="Durum" class="form-label"></label>
            <select asp-for="Durum" asp-items="durumlar" class="form-select"></select>
            <span asp-validation-for="Durum" class="text-danger"></span>
        </div>
    }
    <div class="col-sm-6 mb-3">
        <label asp-for="StoryPoint" class="form-label"></label>
        @* min/max verilmez: jQuery Validate onları kendi (İngilizce) mesajıyla denetler; aralık [Range]'den gelir. *@
        <input asp-for="StoryPoint" type="number" class="form-control" placeholder="Boş bırakılabilir"
               data-val-number="Story point bir sayı olmalıdır." />
        <span asp-validation-for="StoryPoint" class="text-danger"></span>
    </div>
    <div class="col-sm-6 mb-3">
        <label asp-for="AtananKullaniciId" class="form-label"></label>
        <select asp-for="AtananKullaniciId" asp-items="Model.AtanabilecekKisiler" class="form-select">
            <option value="">Atanmamış</option>
        </select>
        @if (Model.UyeOlmayanAtananAdi is string eskiAtanan)
        {
            <div class="form-text text-danger">@eskiAtanan artık projenin üyesi değil. Kaydederseniz görev atanmamış olur; isterseniz başka bir üye seçin.</div>
        }
        <span asp-validation-for="AtananKullaniciId" class="text-danger"></span>
    </div>
</div>

@if (!duzenlemeMi)
{
    <p class="text-muted small">Yeni görev <strong>Yapılacak</strong> durumunda backlog'a eklenir. Sprinte atamak için Sprint planlama sayfasını kullanın.</p>
}
