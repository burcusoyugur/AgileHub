@model Gorev
@{
    ViewData["Title"] = Model.Baslik;

    var atanan = Model.AtananKullanici is null
        ? null
        : $"{Model.AtananKullanici.Ad} {Model.AtananKullanici.Soyad}".Trim();
    if (Model.AtananKullanici is not null && string.IsNullOrWhiteSpace(atanan))
    {
        atanan = Model.AtananKullanici.UserName;
    }

    // Görev aktif sprintteyse panoya dönüş bağlantısı gösterilir.
    var aktifSprintte = Model.Sprint?.Durum == SprintDurumu.Aktif;

    // Durum formu gönderildikten sonra kullanıcı bu sayfaya geri döner.
    var donusAdresi = $"/Gorev/Details/{Model.Id}";
}

@if (TempData["Mesaj"] is string mesaj)
{
    <div class="alert alert-success">@mesaj</div>
}

@if (TempData["Hata"] is string hata)
{
    <div class="alert alert-danger">@hata</div>
}

@* Gezinme *@
<nav class="d-flex flex-wrap gap-3 small mb-3" aria-label="Gezinme">
    @if (aktifSprintte)
    {
        <a href="/Pano?projeId=@Model.ProjeId">&larr; Panoya dön</a>
    }
    <a href="/Gorev?projeId=@Model.ProjeId">&larr; Backlog'a dön</a>
</nav>

@* Üst kısım: başlık, rozetler, Düzenle / Sil *@
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-4">
    <div>
        <h1 class="h3 mb-2 text-break">@Model.Baslik</h1>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <partial name="_GorevDurumRozeti" model="Model.Durum" />
            <partial name="_GorevOncelikRozeti" model="Model.Oncelik" />
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Düzenle</a>
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">Sil</a>
    </div>
</div>

<div class="row g-3">
    @* Sol: açıklama *@
    <div class="col-lg-8">
        <section class="card h-100" aria-labelledby="aciklama-baslik">
            <div class="card-body">
                <h2 id="aciklama-baslik" class="h5 mb-3">Açıklama</h2>
                @if (string.IsNullOrWhiteSpace(Model.Aciklama))
                {
                    <p class="text-muted mb-0">Açıklama eklenmemiş.</p>
                }
                else
                {
                    <p class="mb-0 text-break" style="white-space: pre-line">@Model.Aciklama</p>
                }
            </div>
        </section>
    </div>

    @* Sağ: bilgi kartı ve durum değiştirme *@
    <div class="col-lg-4 d-flex flex-column gap-3">
        <section class="card" aria-labelledby="bilgi-baslik">
            <div class="card-body">
                <h2 id="bilgi-baslik" class="h5 mb-3">Bilgiler</h2>
                <dl class="row mb-0 small">
                    <dt class="col-5 text-muted fw-normal">Proje</dt>
                    <dd class="col-7 text-break">
                        <a asp-controller="Proje" asp-action="Details" asp-route-id="@Model.ProjeId">@Model.Proje?.Ad</a>
                    </dd>

                    <dt class="col-5 text-muted fw-normal">Sprint</dt>
                    <dd class="col-7 text-break">
                        @if (Model.Sprint is not null)
                        {
                            <a asp-controller="Sprint" asp-action="Details" asp-route-id="@Model.Sprint.Id">@Model.Sprint.Ad</a>
                        }
                        else
                        {
                            <text>Backlog</text>
                        }
                    </dd>

                    <dt class="col-5 text-muted fw-normal">Atanan kişi</dt>
                    <dd class="col-7 text-break">@(atanan ?? "Atanmamış")</dd>

                    <dt class="col-5 text-muted fw-normal">Story point</dt>
                    <dd class="col-7">@(Model.StoryPoint?.ToString() ?? "–")</dd>

                    <dt class="col-5 text-muted fw-normal">Oluşturulma</dt>
                    <dd class="col-7 mb-0">@Model.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</dd>
                </dl>
            </div>
        </section>

        <section class="card" aria-labelledby="durum-baslik">
            <div class="card-body">
                <h2 id="durum-baslik" class="h5 mb-3">Durumu değiştir</h2>
                @* Esra'nın action'ı (hafta5/durum-guncelleme) henüz main'de değil; bu yüzden asp-action yerine düz adres. *@
                <form method="post" action="/Gorev/DurumGuncelle">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="donusAdresi" value="@donusAdresi" />
                    <div class="row row-cols-2 g-2">
                        @foreach (var durum in Enum.GetValues<GorevDurumu>())
                        {
                            var secili = durum == Model.Durum;
                            <div class="col">
                                <button type="submit" name="durum" value="@durum"
                                        class="btn btn-sm w-100 @(secili ? "btn-primary" : "btn-outline-secondary")"
                                        disabled="@secili">
                                    @if (secili)
                                    {
                                        <span aria-hidden="true">✓</span>
                                    }
                                    @durum.Metin()
                                    @if (secili)
                                    {
                                        <span class="visually-hidden">(mevcut durum)</span>
                                    }
                                </button>
                            </div>
                        }
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>

@* Yorumlar: liste ve yorum formu Erkim'in bileşeninden gelir. *@
<section id="yorumlar" class="card mt-3" aria-labelledby="yorumlar-baslik">
    <div class="card-body">
        <h2 id="yorumlar-baslik" class="h5 mb-3">
            Yorumlar <span class="badge bg-secondary">@Model.Yorumlar.Count</span>
        </h2>
        @await Component.InvokeAsync("Yorumlar", new { gorevId = Model.Id })
    </div>
</section>
