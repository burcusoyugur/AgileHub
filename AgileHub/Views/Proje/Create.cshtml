@model ProjeFormViewModel
@{
    ViewData["Title"] = "Yeni proje";
}

<h1 class="h3 mb-3">@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <partial name="_ProjeForm" model="Model" />
            <button type="submit" class="btn btn-primary">Oluştur</button>
            <a class="btn btn-link" asp-action="Index">Vazgeç</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
